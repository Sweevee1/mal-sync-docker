generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One row per external service: "MAL" | "ANILIST" | "KITSU"
model ServiceCredential {
  id       Int    @id @default(autoincrement())
  service  String @unique

  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?

  // Kitsu only: stored so the password grant can be redone if refresh fails
  kitsuUsernameEnc String?
  kitsuPasswordEnc String?
  kitsuUserId      String? // Kitsu's internal numeric user id, needed for library-entries lookups

  // MAL only: needed for GET /users/{user_name}/animelist
  malUsername String?

  // MAL + AniList: the registered OAuth app's own client id/secret, entered via
  // the Connect Services UI instead of environment variables. MAL's PKCE "other"
  // app type has no secret, so clientSecretEnc is AniList-only.
  clientId        String?
  clientSecretEnc String?

  // Transient OAuth handshake state (MAL PKCE verifier / CSRF state for MAL+AniList).
  // redirectUri is built from PUBLIC_BASE_URL at /start time and stored here
  // so /callback reuses the exact same value rather than re-deriving it.
  codeVerifier String?
  oauthState   String? // sha256 hex of the state sent to the provider
  oauthStateExpiresAt DateTime?
  redirectUri  String?

  connectedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

// Cache of resolved MAL ID -> AniList/Kitsu media ID, to avoid repeated lookups.
// A non-null lookupAt with a null id is a cached negative (confirmed unmappable).
model MediaMapping {
  id        Int    @id @default(autoincrement())
  malId     Int
  mediaType String // "ANIME" | "MANGA"

  anilistId       Int?
  anilistLookupAt DateTime?

  kitsuId       String?
  kitsuLookupAt DateTime?

  @@unique([malId, mediaType])
}

// Cached snapshot of MAL list state plus per-service sync status.
model ListEntry {
  id        Int    @id @default(autoincrement())
  malId     Int
  mediaType String // "ANIME" | "MANGA"
  title     String

  status          String
  score           Int
  progress        Int // episodes watched / chapters read
  volumesProgress Int? // manga only
  startDate       String?
  finishDate      String?
  malUpdatedAt    DateTime

  anilistSyncStatus  String    @default("PENDING") // SYNCED | PENDING | SKIPPED_UNMAPPABLE | ERROR | PENDING_DELETION | NOT_APPLICABLE
  anilistSyncedAt    DateTime?
  anilistLastError   String?
  anilistListEntryId String?

  kitsuSyncStatus  String    @default("PENDING")
  kitsuSyncedAt    DateTime?
  kitsuLastError   String?
  kitsuLibraryEntryId String?

  @@unique([malId, mediaType])
}

model SyncRun {
  id          Int       @id @default(autoincrement())
  trigger     String // MANUAL | SCHEDULED
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String    @default("RUNNING") // RUNNING | SUCCESS | PARTIAL_FAILURE | FAILED
  animeCount  Int       @default(0)
  mangaCount  Int       @default(0)
  pushedCount Int       @default(0)
  skippedCount Int      @default(0)
  errorCount  Int       @default(0)
  errorMessage String?

  entries SyncRunEntry[]
}

model SyncRunEntry {
  id        Int      @id @default(autoincrement())
  syncRunId Int
  syncRun   SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  malId     Int
  mediaType String
  title     String
  service   String // ANILIST | KITSU
  outcome   String // PUSHED | SKIPPED_UNMAPPABLE | SKIPPED_UNCHANGED | ERROR | DELETED
  detail    String?
  createdAt DateTime @default(now())
}

// Single-row settings table.
model AppSetting {
  id                  Int       @id @default(1)
  syncIntervalMinutes Int       @default(60)
  lastFullSyncAt      DateTime?
  // sha256 of ADMIN_PASSWORD_HASH; a change invalidates all sessions at startup.
  adminHashFingerprint String?
  // Password chosen in the UI (setup mode). ADMIN_PASSWORD_HASH wins when set and is mirrored here.
  adminPasswordHash    String?
}

// Owner login sessions. Only the sha256 of the cookie token is stored.
model Session {
  idHash     String   @id
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
}
