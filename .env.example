# Server
PORT=3000

# Owner login. Generate the hash (the password is read from stdin, so it never
# lands in shell history if you type it at the prompt):
#   Docker: docker run --rm -i --entrypoint node ghcr.io/sweevee1/mal-sync-docker:latest dist/tools/hashPassword.js
#   Local dev: npm run hash-password -w backend
# Changing this hash signs out every existing session.
ADMIN_PASSWORD_HASH=

# The exact URL you browse to, with no path. Used to build OAuth redirect URIs
# and cookie settings, never taken from request headers. An https URL requires
# the proxy settings below, or logins are rejected.
PUBLIC_BASE_URL=http://localhost:3000

# Set to "true" ONLY if this app sits behind a reverse proxy that terminates
# HTTPS and sets X-Forwarded-Proto. This gates whether Kitsu password login is
# allowed (it's blocked over plain HTTP; the token-paste method still works
# either way) and whether login works at all when PUBLIC_BASE_URL is https.
# Never enable this if the app's port is exposed directly; a client could
# otherwise forge that header to fake HTTPS.
TRUST_PROXY=false

# Only used when TRUST_PROXY=true. Comma-separated IPs/CIDRs of your reverse
# proxy (e.g. its Docker network subnet). Defaults to loopback only, so name
# your proxy explicitly; anything not listed cannot set X-Forwarded-* headers.
# TRUST_PROXY_CIDRS=172.18.0.0/16

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# MyAnimeList and AniList OAuth app credentials (Client ID/Secret) are entered
# through the Connect Services page in the UI, not here; they're stored
# (secret encrypted) in the database so nothing needs editing this file to
# connect an account. See the README's "Getting Your API Credentials" section.

# Default interval (minutes) seeded into settings on first boot
DEFAULT_SYNC_INTERVAL_MINUTES=60

# SQLite database location. The Dockerfile already bakes in this exact value
# as the image's default, so you don't need to set this for docker-compose,
# Unraid, or any other Docker deployment; it's listed here only so it's
# discoverable, and as an escape hatch if you ever need to override it.
# Must be an absolute path pointing at the mounted volume if you do: Prisma's
# relative "file:" path resolution differs between the CLI (migrate deploy)
# and the runtime client, so a relative path here risks the database landing
# outside /app/data and losing data on container recreation.
DATABASE_URL=file:/app/data/malsync.db
