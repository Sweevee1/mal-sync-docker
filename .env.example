# Server
PORT=3000

# Set to "true" ONLY if this app sits behind a reverse proxy that terminates
# HTTPS and sets X-Forwarded-Proto. This gates whether Kitsu password login is
# allowed (it's blocked over plain HTTP; the token-paste method still works
# either way). Never enable this if the app's port is exposed directly;
# a client could otherwise forge that header to fake HTTPS.
TRUST_PROXY=false

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# MyAnimeList API (https://myanimelist.net/apiconfig)
# App Type: "other", no client secret required (PKCE flow)
MAL_CLIENT_ID=
MAL_REDIRECT_URI=http://localhost:3000/api/auth/mal/callback

# AniList API (https://anilist.co/settings/developer)
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=http://localhost:3000/api/auth/anilist/callback

# Default interval (minutes) seeded into settings on first boot
DEFAULT_SYNC_INTERVAL_MINUTES=60

# SQLite database location. Must be an absolute path pointing at the mounted
# volume. Prisma's relative "file:" path resolution differs between the CLI
# (migrate deploy) and the runtime client, so a relative path here risks the
# database landing outside /app/data and losing data on container recreation.
DATABASE_URL=file:/app/data/malsync.db
